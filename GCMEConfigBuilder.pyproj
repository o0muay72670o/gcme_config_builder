<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{1CA4AA89-D201-4B47-89C8-9B60AEF7BDA3}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <SearchPath>.</SearchPath>
    <Name>GCME Config Builder</Name>
    <RootNamespace>GCMEConfigBuilder</RootNamespace>
    <CommandLineArguments>--help</CommandLineArguments>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="config_builder\**\*.py" />
    <Compile Include="tests\**\*.py" />
    <Content Include="requirements.txt" />
    <Content Include="README.md" />
    <Content Include="AGENTS.md" />
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Description>Project .venv (Python 3.12)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <Version>3.12</Version>
      <Architecture>X64</Architecture>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Python is interpreted; this project has no compilation step. -->
  <Target Name="CoreCompile" />
</Project>

